<!-- Iitlhokomeleng Association for Aged & Disabled — Contact Page -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Contact — Iitlhokomeleng Association for Aged & Disabled</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="css/style.css" />
</head>
<body>
  <header>
    <div class="container">
      <a href="index.html" class="logo">
        <img src="images/logo.png" alt="Iitlhokomeleng logo" />
      </a>
      <nav>
        <ul>
          <li><a href="index.html">Home</a></li>
          <li><a href="about.html">About Us</a></li>
          <li><a href="services.html">Services</a></li>
          <li><a href="enquiry.html">Get Involved</a></li>
          <li><a href="contact.html">Contact</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main>
    <section class="page-intro">
      <div class="container">
        <h1>Contact Us</h1>
        <p>We’re here to help. Reach out via phone, email, or the form below.</p>
      </div>
    </section>

    <section class="contact-details">
      <div class="container two-col">
        <div>
          <h2>Get in Touch</h2>
          <p><strong>Phone:</strong> [Insert phone]</p>
          <p><strong>Email:</strong> [Insert email]</p>
          <p><strong>Address:</strong> [Insert physical address]</p>
          <p><strong>Hours:</strong> [Insert operating hours]</p>
        </div>
        <div>
          <h2>Send a Message</h2>
          <form id="contact-form" action="#" method="post">
            <label for="c-name">Name</label>
            <input type="text" id="c-name" name="c-name" required />

            <label for="c-email">Email</label>
            <input type="email" id="c-email" name="c-email" required />

            <label for="c-subject">Subject</label>
            <input type="text" id="c-subject" name="c-subject" required />

            <label for="c-message">Message</label>
            <textarea id="c-message" name="c-message" rows="5" required></textarea>

            <button type="submit" class="btn">Send Message</button>
          </form>
        </div>
      </div>
    </section>

    <!-- Map -->
    <section class="map-section">
      <div class="container">
        <h2>Our Location</h2>
        <!-- Replace src with actual Google Maps embed URL -->
        <iframe
          title="Iitlhokomeleng location map"
          src="https://www.google.com/maps/embed?pb=!"
          width="100%" height="300" style="border:0;" allowfullscreen="" loading="lazy">
        </iframe>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">
      <p>&copy; 2026 Iitlhokomeleng Association for Aged & Disabled. All rights reserved.</p>
      <p>[Phone] | [Email] | [Physical Address]</p>
    </div>
  </footer>